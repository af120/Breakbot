# Car Wash Manager - Environment Variables
# Copy this file to .env and fill in your values

# === Required for Production ===

# JWT secret key for authentication (use a strong random string)
JWT_SECRET=change-this-to-a-strong-random-secret-key

# === Cloudflare Configuration ===
# These are set automatically by Cloudflare when deployed
# D1 Database - configured in wrangler.jsonc
# R2 Bucket - configured in wrangler.jsonc

# === Optional: Image Storage ===
# For production image uploads via Cloudinary
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# === Optional: Custom Domain ===
# PUBLIC_URL=https://your-carwash.pages.dev
# BOOKING_URL=https://your-carwash.pages.dev/book

# === Development Only ===
# VITE_API_URL=http://localhost:8787
