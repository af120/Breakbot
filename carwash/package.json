{
  "name": "carwash-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Car Wash Manager - Complete car wash business management system for Iraq",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:worker\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed.js",
    "db:migrate:local": "wrangler d1 migrations apply carwash-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply carwash-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "hono": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "typescript": "~5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "wrangler": "^4.0.0"
  }
}
